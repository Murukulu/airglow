{
  "json": {
  },
  "markdown": {
  },
  "toml": {
  },
  "ruff": {
  },
  "yaml": {
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt",
        "exts": ["rs"]
      }
